# Supabase 配置（开发/生产）。复制为 .env 并填入你的实例值。
# 获取方式：Supabase Dashboard -> Settings -> API -> Project URL / publishable (or legacy anon) key
# 移动端只能配置可公开客户端密钥；绝不能放入 secret 或 service_role key。
# 未配置时 app 自动走本地 demo 模式（现有 MVP 行为不变）。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OCR provider 模式（on-device 已实施，2026-07-24）。
#   device = on-device（默认；Apple Vision + Google ML Kit，image+PDF，无 PHI 风险，离线）
#            需 prebuild/EAS Build（原生模块，Expo Go 不可用）；Expo Go 开发期临时用 mock
#   mock   = 演示置信度（Expo Go 开发期回退）
#   cloud  = 云端兜底（AWS Textract / Google Document AI，需 BAA + Supabase Edge Function）
# 切换只需改此变量，调用方（actions.addDocument）无需改动。
EXPO_PUBLIC_OCR_MODE=device
