# Supabase 配置（开发/生产）。复制为 .env 并填入你的实例值。
# 获取方式：Supabase Dashboard -> Settings -> API -> Project URL / anon public key
# 未配置时 app 自动走本地 demo 模式（现有 MVP 行为不变）。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OCR provider 模式（决策 1B：试点期 mock）。
#   mock   = 演示置信度（默认，试点期）
#   device = on-device（Apple Vision + Google ML Kit，试点后启用，无 PHI 风险）
#   cloud  = 云端兜底（AWS Textract / Google Document AI，需 BAA + Supabase Edge Function）
# 未设置时默认 mock。切换只需改此变量，调用方（actions.addDocument）无需改动。
EXPO_PUBLIC_OCR_MODE=mock
