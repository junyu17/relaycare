  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26"
