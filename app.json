{
  "expo": {
    "name": "TaskKin Care",
    "slug": "taskkin-care",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "taskkin-care",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cd.cc.relaycare",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f7faf7"
      },
      "package": "cd.cc.taskkincare",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "TaskKin Care uses the camera to scan your family join QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "./plugins/with-dev-team",
        {
          "teamId": "255R6QQR97",
          "nodePath": "/Users/jun/.hermes/node/bin/node"
        }
      ],
      "./plugins/with-no-push-entitlement"
    ]
  }
}
