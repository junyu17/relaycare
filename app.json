{
  "expo": {
    "name": "TaskKin Care",
    "slug": "taskkin-care",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "taskkin-care",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cd.cc.relaycare",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f7faf7"
      },
      "package": "cd.cc.taskkincare",
      "versionCode": 1,
      "allowBackup": false
    },
    "plugins": [
      "expo-font",
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "TaskKin Care uses the camera to scan your family join QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "./plugins/with-dev-team",
        {
          "teamId": "255R6QQR97",
          "nodePath": "/Users/jun/.hermes/node/bin/node"
        }
      ]
    ]
  }
}
