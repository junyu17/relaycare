# keystore.properties 模板（复制为 keystore.properties 并填入真实值）
# 生成 keystore: keytool -genkeypair -v -storetype PKCS12 -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# ⚠️ keystore 文件必须异地备份，丢了等于这个 App 再也发不了更新。
storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
